# Copy to .env.server on the server and fill the empty values. Never commit .env.server.
APP_NAME="AI HR Employee"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hr-starter.example.com
APP_HOST=hr-starter.example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=starter
DB_USERNAME=starter
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

# The demo accounts' password. On a public server set your own long one here:
# with the default from README.md anyone could sign in and spend your AI key.
DEMO_PASSWORD=

# Where the admin settings may point the server: the AI provider and the mailbox.
# Comma separated, "*.domain" for a whole domain. Left out: Ollama, the course gateway, Gmail and Outlook.
# Setting it replaces the whole list, so keep api.hr.dev.fyntralink.com in it if you use the course key.
# OUTBOUND_HOSTS="ollama.com,api.hr.dev.fyntralink.com,imap.gmail.com,smtp.gmail.com"

VITE_APP_NAME="${APP_NAME}"
